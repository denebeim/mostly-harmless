$TTL 300
@   IN  SOA services.{{ domain_name }}. hostmaster.{{ domain_name }}. (
        2026112001 ; Serial
        3600       ; Refresh
        900        ; Retry
        604800     ; Expire
        300 )      ; Negative Cache TTL
;
@   IN  NS  services.{{ domain_name }}.

{% for h in isc_hosts_list %}
{{ h.name }}    IN  A   {{ h.ip }}
{% endfor %}
