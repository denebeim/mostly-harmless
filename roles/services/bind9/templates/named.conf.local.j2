key "{{ bind9_ddns_key_name }}" {
    algorithm hmac-sha256;
    secret "{{ bind9_ddns_key_secret }}";
};

zone "{{ bind9_domain_name }}" {
    type primary;
    file "/var/lib/bind/db.local.deepthot.org";
    allow-update { key "{{ bind9_ddns_key_name }}"; };
    allow-transfer { none; };
};

zone "42.168.192.in-addr.arpa" {
    type primary;
    file "/var/lib/bind/db.192.168.42";
    allow-update { key "{{ bind9_ddns_key_name }}"; };
    allow-transfer { none; };
};

zone "43.168.192.in-addr.arpa" {
    type primary;
    file "/var/lib/bind/db.192.168.43";
    allow-update { key "{{ bind9_ddns_key_name }}"; };
    allow-transfer { none; };
};
