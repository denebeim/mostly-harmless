#!/usr/bin/python3
"""Click once to dictate into standalone Gemini; click again to stop and submit."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys
import time
import gi
gi.require_version('Gio', '2.0')
from gi.repository import Gio, GLib

BUS = 'org.gnome.Shell'
OBJ = '/org/gnome/Shell/Extensions/GeminiFocus'
IFACE = 'org.gnome.Shell.Extensions.GeminiFocus'

def call(method, action=None):
    params = GLib.Variant('(s)', (action,)) if action is not None else None
    return Gio.bus_get_sync(Gio.BusType.SESSION, None).call_sync(
        BUS, OBJ, IFACE, method, params, GLib.VariantType.new('(s)'),
        Gio.DBusCallFlags.NONE, 3000, None).unpack()[0]

def focus():
    deadline = time.monotonic() + 25
    launched = False
    ready_after = 0
    while time.monotonic() < deadline:
        status = call('Focus')
        if status == 'locked':
            raise RuntimeError('Desktop is locked; no input sent')
        if status == 'missing' and not launched:
            subprocess.Popen(['/opt/google/chrome/google-chrome',
                '--profile-directory=' + {{ gemini_chrome_profile | to_json }}, '--app=https://gemini.google.com/app'],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                start_new_session=True)
            launched = True
            ready_after = time.monotonic() + 2.5
        if status == 'focused' and time.monotonic() >= ready_after:
            state = json.loads(call('Status'))
            for window in state['windows']:
                if window['focused']: return window['id']
        time.sleep(.05)
    raise RuntimeError('Gemini did not acquire focus; no input sent')

def send(action):
    deadline = time.monotonic() + 2
    while True:
        result = call('Send', action)
        if result == 'sent': return
        if result != 'modifiers-held' or time.monotonic() >= deadline:
            raise RuntimeError(f'Input refused: {result}')
        time.sleep(.015)

def read_state(path):
    try: return json.loads(path.read_text())
    except (FileNotFoundError, ValueError): return {}

def save_state(path, state):
    tmp = path.with_suffix('.new')
    tmp.write_text(json.dumps(state, indent=2) + "\n")
    tmp.chmod(0o600)
    tmp.replace(path)

def toggle(window, path):
    state = read_state(path)
    if state.get('window') != window:
        state = {}
    if state.get('phase') in ('dictating', 'pending-submit'):
        if state['phase'] == 'dictating':
            send('dictate')
            save_state(path, {'window':window, 'phase':'pending-submit'})
            time.sleep(.6)  # Allow Chrome to commit the last recognition result.
        send('submit')
        path.unlink(missing_ok=True)
        print('Gemini dictation stopped and submitted')
    else:
        send('dictate')
        save_state(path, {'window':window, 'phase':'dictating'})
        print('Gemini dictation started')

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--status', action='store_true')
    parser.add_argument('--focus-only', action='store_true')
    parser.add_argument('--reset', action='store_true', help='Reset click state after manually changing the microphone')
    args = parser.parse_args()
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))
    path = runtime/'gemini-toggle-state.json'
    if args.status:
        print(json.dumps({'desktop':json.loads(call('Status')), 'toggle':read_state(path)}));return
    with (runtime/'gemini-toggle.lock').open('w') as lock:
        try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError: return
        if args.reset:
            path.unlink(missing_ok=True);print('Gemini click state reset; no input sent');return
        window = focus()
        if args.focus_only:
            print('Gemini focused');return
        toggle(window, path)

if __name__ == '__main__':
    try: main()
    except Exception as error:
        print(f'gemini-toggle: {error}', file=sys.stderr)
        sys.exit(1)
